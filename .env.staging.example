# Copy to .env.staging.local. Staging commands read this separate file explicitly.
# The URI must include /DengueStickStagingDB and use a staging-only database account.
STAGING_MONGODB_URI=
STAGING_MONGODB_DB=DengueStickStagingDB
STAGING_BETTER_AUTH_SECRET=

# Required only for reusable administrator provisioning.
# Use a reserved @example.test address.
STAGING_AUTH_ADMIN_EMAIL=tonmoybiswas13900@gmail.com
STAGING_AUTH_ADMIN_PASSWORD=TONMOYbiswas@1
