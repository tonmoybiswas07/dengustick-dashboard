# Copy to .env.development.local for local development. Fill in required values.
# In staging and production, inject values through the deployment environment.

# Required. Use a dedicated local or staging replica set during development.
MONGODB_URI=
# Optional for the application. Defaults to DengueStickDB.
# Always select the intended database explicitly when running index migrations.
MONGODB_DB=DengueStickDB

# Required. Generate an independent secret for each environment.
BETTER_AUTH_SECRET=
# Required in production. Replace the development origin with the exact public HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Configure only if a trusted ingress overwrites this header with one client IP.
AUTH_TRUSTED_IP_HEADER=
# Optional. Enables integration tests against a dedicated local MongoDB replica set.
MONGODB_TEST_URI=

# Optional. Reserved for a configured inference service. Supply both values together.
INFERENCE_API_URL=
INFERENCE_API_TOKEN=

# Optional managed private inspection images. Configure all three together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional FastAPI transport settings. Health checks stay on the inference origin.
INFERENCE_TIMEOUT_MS=15000
INFERENCE_HEALTH_PATH=

# Required to enable the durable inference dispatch endpoint. Use a separate secret.
INFERENCE_WORKER_SECRET=
# Optional path prefix for validated annotation bytes on the inference origin.
INFERENCE_ANNOTATION_PATH=

# Set only when a deployment scheduler will invoke POST /api/reports/worker.
REPORT_WORKER_SECRET=

# Optional password recovery. Configure a verified Resend sender and an HTTPS BETTER_AUTH_URL.
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=
